<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Something went wrong</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md bg-white p-8 rounded-xl shadow-xl text-center">
        <h1 class="text-2xl font-bold text-red-600 mb-3">Oops!</h1>
        <p class="text-gray-600 mb-6"><%= message %></p>
        <a href="/ai" class="inline-block bg-indigo-600 text-white px-5 py-2.5 rounded-lg hover:bg-indigo-700 transition">Try Again</a>
    </div>
</body>
</html>